[sub_resource type="Resource" id="Water"]
script = ExtResource("section")
kind = 4
water_lanes = Array[ExtResource("lane")]([SubResource("Boat"), SubResource("LongBoat"), SubResource("Log")])

[resource]
script = ExtResource("level")
display_name = "Water Workshop"
time_limit = 180.0
