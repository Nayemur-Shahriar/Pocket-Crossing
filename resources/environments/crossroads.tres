props = Array[Texture2D]([ExtResource("urban_facade"), ExtResource("tea_stall"), ExtResource("ghat_steps"), ExtResource("lamp"), ExtResource("bridge_rail")])
vegetation = Array[Texture2D]([ExtResource("palm"), ExtResource("banana"), ExtResource("bamboo")])
prop_density = 1.0
vegetation_density = 0.9
guard_rails = true
